# Copier : cp .env.example .env — ne pas committer .env.
#
# Encodage du fichier : enregistrer ce fichier en UTF-8 dans l’éditeur (éviter ANSI / Windows-1252),
# sinon des commentaires accentués peuvent corrompre des valeurs lues par python-dotenv.
#
# Django et scripts sur l’hôte utilisent localhost + ports mappés par Docker.
# Celery / Flower : surcharges réseau dans docker-compose.yml (noms de services postgres, redis, minio).

# ─── PostgreSQL (TimescaleDB dans Docker) ───────────────────────────
# Windows : si un « PostgreSQL » est installé en local, il occupe souvent le port 5432.
# Dans ce cas localhost:5432 ne pointe pas vers le conteneur → erreur d’authentification.
# Solutions : (1) arrêter le service PostgreSQL Windows le temps du dev ; (2) exposer Docker sur un
# autre port, ex. "5433:5432" dans docker-compose et POSTGRES_PORT=5433 ci‑dessous ;
# (3) vérifier avec docker compose ps que postgres écoute bien sur le port attendu.
#
# UnicodeDecodeError (ex. octet 0xe9) : le stack Django utilise psycopg v3 (requirements.txt).
# PGCLIENTENCODING=UTF8 ci‑dessous ; fichier .env en UTF-8 ; manage.py fixe PGCLIENTENCODING sous Windows.
POSTGRES_DB=urbanhub
POSTGRES_USER=urbanhub
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PGCLIENTENCODING=UTF8

# ─── Redis (broker Celery) ───────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── MinIO (Data Lake) — API S3 ─────────────────────────────────────
# Si le port 9000 est déjà pris sur l’hôte (autre MinIO, Portainer…), adaptez docker-compose
# (ex. "19000:9000" / "19001:9001") et mettez MINIO_ENDPOINT=http://127.0.0.1:19000 ici.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=__CHANGE_ME_MIN_8_CHARS__
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET_RAW=urbanhub-raw
MINIO_BUCKET_PROCESSED=urbanhub-processed
MINIO_BUCKET_ANALYTICS=urbanhub-analytics

# ─── Django ──────────────────────────────────────────────────────────
SECRET_KEY=__CHANGE_ME_LONG_RANDOM_STRING__
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Jupyter (optionnel) ─────────────────────────────────────────────
JUPYTER_TOKEN=__CHANGE_ME__

# ─── APIs externes (optionnel) ───────────────────────────────────────
OPENAQ_API_KEY=
NOAA_BASE_URL=https://www.ncei.noaa.gov/data/global-hourly/access
NOAA_STATION_LIST_URL=https://www.ncei.noaa.gov/pub/data/noaa/isd-history.csv
CITYBIKES_API_URL=http://api.citybik.es/v2
